# Voice AI Evaluation Suite — environment template
# Copy this file to .env and add your own credentials. Never commit .env.

# LLM providers (at least one is needed for real simulation/scoring)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Backend
PORT=3001
NODE_ENV=development
DB_PATH=./bais-eval.db

# Voice evaluation providers
STT_PROVIDER=openai
LLM_PROVIDER=openai
# GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENAI_STT_MODEL=whisper-1
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# OPENAI_LLM_MODEL=gpt-4o-mini

# LiveKit streaming STT/TTS and turn-taking
# DEEPGRAM_STT_MODEL=nova-2-phonecall
# DEEPGRAM_TTS_MODEL=aura-arcas-en
# DEEPGRAM_TTS_SPEED=1.0
# LIVEKIT_FLUX_STT=true
# LIVEKIT_FLUX_EOT_THRESHOLD=0.8
# LIVEKIT_FLUX_EAGER_EOT=0.7
# LIVEKIT_FLUX_EOT_TIMEOUT_MS=5000
# LIVEKIT_FLUX_MODEL=deepgram/flux-general-en
# LIVEKIT_SIM_ENDPOINT_MIN_DELAY_MS=650
# LIVEKIT_SIM_ENDPOINT_MAX_DELAY_MS=3000
# LIVEKIT_SIM_PREEMPTIVE_GENERATION=false
# LIVEKIT_CLOSING_GRACE_MS=4000

# Optional LiveKit call recording to S3
LIVEKIT_RECORDING=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Twilio and LiveKit telephony credentials are entered in the app under
# Settings > Voice Simulation and are stored only in the local SQLite database.
